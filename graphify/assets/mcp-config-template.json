{
  "mcp": {
    "servers": {
      "code-review-graph": {
        "command": "code-review-graph",
        "args": ["serve"],
        "cwd": "<repo-root>",
        "transport": "stdio"
      },
      "codegraphcontext": {
        "command": "cgc",
        "args": ["mcp", "start"],
        "cwd": "<repo-root>",
        "transport": "stdio"
      }
    }
  }
}
