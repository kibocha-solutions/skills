# Other commands
# --------------------------------------------------------------------------

def cmd_status(args: argparse.Namespace, ui: UI) -> int:
    project = load_project(args)
    rt = Runtime(project.config.runtime)
    running = dict(rt.containers(f"wrs.project={project.slug}"))
    state_file = serve_state_path(project)
    serving = state_file.is_file() and any(n.startswith("wrs-serve-") and s.lower().startswith("up")
                                          for n, s in running.items())
    rows, data = [], []
    for inst in project.instances:
        meta_file = project.home / "artifacts" / inst.id / "build.json"
        meta = json.loads(meta_file.read_text()) if meta_file.is_file() else {}
        url = ""
        if serving:
            st = json.loads(state_file.read_text())
            port = next((p["port"] for p in st["instances"] if p["id"] == inst.id), None)
            url = f"http://localhost:{port}/" if port else ""
        built = meta.get("finished", "never").replace("T", " ")
        result = ("ok" if meta.get("ok") else "failed") if meta else "-"
        colored = ui.c(result, "green" if result == "ok" else "red" if result == "failed" else "gray")
        rows.append([inst.id, inst.name, colored, built, str(meta.get("pages", "")), url or "-"])
        data.append({"instance": inst.id, "build": result, "built": built, "pages": meta.get("pages"),
                     "url": url})
    if args.json:
        print(json.dumps({"project": str(project.root), "serving": serving, "instances": data}, indent=2))
        return EXIT_OK
    ui.heading(f"{project.display_name}  {ui.c(str(project.root), 'gray')}  ({rt.cmd}, image {project.config.image_tag})")
    ui.table(["INSTANCE", "TITLE", "BUILD", "BUILT", "PAGES", "SERVED AT"], rows)
    ui.emit()
    ui.info(("server running: " + next(n for n in running if n.startswith("wrs-serve-"))) if serving
            else "server not running (start with: wrs serve)")
    return EXIT_OK


def cmd_stop(args: argparse.Namespace, ui: UI) -> int:
    rt = Runtime(os.environ.get("WRS_RUNTIME", ""))
    label = "wrs.role=serve"
    if not args.all:
        project = load_project(args)
        names = [n for n, _ in rt.containers(f"wrs.project={project.slug}") if n.startswith("wrs-serve-")]
    else:
        names = [n for n, _ in rt.containers(label)]
    if not names:
        ui.info("No wrs server running")
        return EXIT_OK
    with Spinner(ui, "Stopping"):
        for n in names:
            rt.remove(n)
    for n in names:
        ui.ok(f"Stopped {n}")
    return EXIT_OK


def cmd_open(args: argparse.Namespace, ui: UI) -> int:
    project = load_project(args)
    state_file = serve_state_path(project)
    if not state_file.is_file():
        raise WrsError("server not running", "start it with: wrs serve")
    st = json.loads(state_file.read_text())
    if args.instance:
        p = next((p for p in st["instances"] if p["id"] == args.instance), None)
        if not p:
            raise WrsError(f"instance '{args.instance}' is not being served")
        url = f"http://localhost:{p['port']}/{p['start']}"
    else:
        url = f"http://localhost:{st['portal']}/"
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    if shutil.which(opener):
        subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(url)
    return EXIT_OK


def cmd_logs(args: argparse.Namespace, ui: UI) -> int:
    project = load_project(args)
    if args.serve:
        rt = Runtime(project.config.runtime)
        name = f"wrs-serve-{project.slug}"
        return subprocess.call([rt.cmd, "logs", *(["-f"] if args.follow else []), name])
    logs = sorted(project.dir("logs").glob("*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
    if args.instance:
        logs = [p for p in logs if p.stem.endswith(f"-{args.instance}")]
    if not logs:
        ui.info("No build logs yet")
        return EXIT_OK
    if args.instance or args.last:
        latest = logs[0]
        ui.hint(str(latest))
        if args.follow:
            return subprocess.call(["tail", "-f", str(latest)])
        sys.stdout.write(latest.read_text(errors="replace"))
        return EXIT_OK
    ui.table(["LOG", "MODIFIED"], [[str(p), time.strftime("%Y-%m-%d %H:%M", time.localtime(p.stat().st_mtime))]
                                   for p in logs[:15]])
    return EXIT_OK


def cmd_clean(args: argparse.Namespace, ui: UI) -> int:
    project = load_project(args)
    rt = Runtime(project.config.runtime)
    removed = []
    for n, s in rt.containers(f"wrs.project={project.slug}"):
        if not s.lower().startswith("up") or args.all:
            rt.remove(n)
            removed.append(n)
    src = project.home / "src"
    if src.is_dir():
        for d in src.iterdir():
            shutil.rmtree(d, ignore_errors=True)
        removed.append(f"{src}/*")
    if args.all:
        for sub in ("site", "artifacts", "logs", "serve"):
            target = project.home / sub
            if target.exists():
                shutil.rmtree(target, ignore_errors=True)
                removed.append(str(target))
    else:
        logs = sorted((project.home / "logs").glob("*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in logs[40:]:
            old.unlink()
    for r in removed:
        ui.ok(f"removed {r}")
    if not removed:
        ui.info("Nothing to clean")
    return EXIT_OK


def latest_tag() -> tuple[str, str]:
    req = urllib.request.Request(HUB_TAGS_URL, headers={"User-Agent": f"wrs/{VERSION}"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.load(resp)
    tags = [t for t in data.get("results", []) if re.fullmatch(r"\d{4}\.\d{2}\.\d+", t["name"])]
    if not tags:
        raise WrsError("could not find a versioned builder tag on Docker Hub")
    tags.sort(key=lambda t: t["last_updated"], reverse=True)
    return tags[0]["name"], tags[0].get("digest", "")


def cmd_update(args: argparse.Namespace, ui: UI) -> int:
    try:
        project = load_project(args)
        cfg = project.config
    except WrsError:
        project, cfg = None, load_config(Path.cwd(), args)
    rt = Runtime(cfg.runtime)
    with Spinner(ui, "Checking Docker Hub for the latest Writerside builder"):
        tag, digest = latest_tag()
    current = cfg.image_tag
    ui.info(f"configured {current}  {ui.sym('arrow')}  latest {tag}")
    if args.pull or tag != current:
        target = f"{IMAGE_REPO}:{tag}"
        if not rt.image_digest(target) or args.pull:
            with Spinner(ui, f"Pulling {target}"):
                r = rt.run("pull", target, timeout=1800)
            if r.returncode != 0:
                raise WrsError("pull failed", r.stderr.strip()[-400:])
        local = rt.image_digest(target)
        if digest and local and local != "present" and local != digest:
            raise WrsError("digest mismatch between Docker Hub and the pulled image",
                           f"hub {digest}\nlocal {local}")
        ui.ok(f"{target} present ({local or digest})")
    if tag != current:
        where = project.root / ".wrs.toml" if project else Path.home() / ".config/wrs/config.toml"
        ui.hint(f'pin it for the team: add image_tag = "{tag}" to {where}')
    else:
        ui.ok("Builder image is current")
    return EXIT_OK


def cmd_doctor(args: argparse.Namespace, ui: UI) -> int:
    checks: list[tuple[str, bool, str]] = []
    checks.append(("python", sys.version_info >= (3, 11), sys.version.split()[0]))
    try:
        project = load_project(args)
        cfg = project.config
        checks.append(("writerside.cfg", True, str(project.root / "writerside.cfg")))
        checks.append(("instances", True, ", ".join(f"{i.id}({len(i.topics)})" for i in project.instances)))
    except WrsError as exc:
        project, cfg = None, load_config(Path.cwd(), args)
        checks.append(("writerside.cfg", False, str(exc)))
    try:
        rt = Runtime(cfg.runtime)
        checks.append(("runtime", rt.reachable(), f"{rt.cmd} ({rt.version()})"))
        digest = rt.image_digest(cfg.image)
        checks.append(("builder image", bool(digest), f"{cfg.image} {digest[:19] if digest else 'missing'}"))
        checks.append(("nginx image", True,
                       NGINX_IMAGE + ("" if rt.image_digest(NGINX_IMAGE) else " (pulled on first serve)")))
    except WrsError as exc:
        checks.append(("runtime", False, str(exc)))
    try:
        cfg.state_dir.mkdir(parents=True, exist_ok=True)
        checks.append(("state dir", os.access(cfg.state_dir, os.W_OK), str(cfg.state_dir)))
    except OSError as exc:
        checks.append(("state dir", False, str(exc)))
    ports = [cfg.port_base + i for i in range(0, 1 + (len(project.instances) if project else 4))]
    busy = [str(p) for p in ports if not port_free("127.0.0.1", p)]
    checks.append(("ports", not busy, f"{ports[0]}-{ports[-1]}" + (f" busy: {', '.join(busy)}" if busy else " free")))
    if args.online:
        try:
            tag, _ = latest_tag()
            checks.append(("latest image", tag == cfg.image_tag,
                           tag + ("" if tag == cfg.image_tag else " (run: wrs update --pull)")))
        except (urllib.error.URLError, OSError, WrsError) as exc:
            checks.append(("latest image", False, f"lookup failed: {exc}"))
    if args.json:
        print(json.dumps([{"check": n, "ok": ok, "detail": d} for n, ok, d in checks], indent=2))
    else:
        for name, ok, detail in checks:
            mark = ui.c(ui.sym("ok"), "green") if ok else ui.c(ui.sym("fail"), "red")
            ui.emit(f"{mark} {name:<15} {ui.c(detail, 'gray')}")
    return EXIT_OK if all(ok for _, ok, _ in checks) else EXIT_FAIL


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

EPILOG = """examples:
  wrs build                 build every instance
  wrs build internal        build one instance
  wrs serve                 build what is missing, serve ungated instances, follow requests
  wrs serve --dev           open the dev gate (Bitwarden or 1Password) and serve every tier
  wrs serve -d -b           dev mode in the background (stop with: wrs stop)
  wrs check                 confirm no lower-tier page references a higher tier
  wrs status                builds, pages, and URLs at a glance
  wrs update --pull         fetch the latest builder image

configuration (highest first): flags, WRS_* environment variables,
.wrs.toml beside writerside.cfg, ~/.config/wrs/config.toml.
keys: runtime, image_tag, port_base, jobs, sensitivity (list, lowest first),
gated_from (first gated tier, default restricted), dev_item (default wrs-dev;
op://<vault>/<item> selects 1Password), password_manager (bitwarden or 1password;
default: from dev_item, else the installed CLI, Bitwarden first).
"""


def parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-C", "--project", metavar="DIR", help="Writerside project directory")
    common.add_argument("--runtime", choices=["podman", "docker"], help="container runtime")
    common.add_argument("--json", action="store_true", help="machine-readable output on stdout")
    common.add_argument("--no-color", action="store_true", help="disable color (NO_COLOR also works)")
    common.add_argument("--plain", action="store_true", help="no color, animation, or symbols")

    p = argparse.ArgumentParser(prog="wrs", description="Build and serve Writerside documentation.",
                                epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"wrs {VERSION}")
    sub = p.add_subparsers(dest="command", metavar="COMMAND")

    b = sub.add_parser("build", parents=[common], help="build instances (default: all)")
    b.add_argument("instances", nargs="*")
    b.add_argument("-j", "--jobs", type=int, help="parallel builds (default: from CPU and memory)")
    b.add_argument("--image-tag", help="builder image tag")
    b.add_argument("--keep-src", action="store_true", help="keep the temporary source copy")
    b.set_defaults(func=cmd_build)

    s = sub.add_parser("serve", parents=[common], help="serve built instances (default: all)")
    s.add_argument("instances", nargs="*")
    s.add_argument("-d", "--dev", action="store_true",
                   help="open the dev gate and serve every tier locally")
    s.add_argument("-b", "--background", action="store_true", help="run in the background")
    s.add_argument("--build", action="store_true", help="rebuild before serving (missing sites always build)")
    s.add_argument("-j", "--jobs", type=int, help="parallel builds with --build")
    s.add_argument("--image-tag", help="builder image tag with --build")
    s.add_argument("--port-base", type=int, help=f"portal port; instances use the next ports (default {DEFAULT_PORT_BASE})")
    s.add_argument("--lan", action="store_true", help="expose ungated instances on all interfaces")
    s.add_argument("--lan-all", action="store_true",
                   help="with --dev, also expose gated instances on all interfaces behind the dev key")
    s.add_argument("--password-manager", choices=sorted(VAULTS), help="dev key store with --dev (default: auto)")
    s.set_defaults(func=cmd_serve)

    st = sub.add_parser("status", parents=[common], help="show builds and server state")
    st.set_defaults(func=cmd_status)

    ck = sub.add_parser("check", parents=[common], help="check that no lower-tier page references a higher tier")
    ck.set_defaults(func=cmd_check)

    k = sub.add_parser("key", parents=[common], help="dev gate key: status, rotate, or lock")
    k.add_argument("action", choices=["status", "rotate", "lock"])
    k.add_argument("--password-manager", choices=sorted(VAULTS), help="dev key store (default: auto)")
    k.set_defaults(func=cmd_key)

    so = sub.add_parser("stop", parents=[common], help="stop the server")
    so.add_argument("--all", action="store_true", help="stop wrs servers for every project")
    so.set_defaults(func=cmd_stop)

    o = sub.add_parser("open", parents=[common], help="open the portal or an instance in the browser")
    o.add_argument("instance", nargs="?")
    o.set_defaults(func=cmd_open)

    lg = sub.add_parser("logs", parents=[common], help="list or show build logs")
    lg.add_argument("instance", nargs="?")
    lg.add_argument("--last", action="store_true", help="print the newest log")
    lg.add_argument("-f", "--follow", action="store_true")
    lg.add_argument("--serve", action="store_true", help="server access log")
    lg.set_defaults(func=cmd_logs)

    c = sub.add_parser("clean", parents=[common], help="remove temporary sources and stale containers")
    c.add_argument("--all", action="store_true", help="also remove sites, artifacts, and logs")
    c.set_defaults(func=cmd_clean)

    u = sub.add_parser("update", parents=[common], help="check for and pull the latest builder image")
    u.add_argument("--pull", action="store_true", help="pull even when the tag is unchanged")
    u.set_defaults(func=cmd_update)

    d = sub.add_parser("doctor", parents=[common], help="check the environment")
    d.add_argument("--online", action="store_true", help="also compare with the latest image on Docker Hub")
    d.set_defaults(func=cmd_doctor)
    return p


def main(argv: list[str] | None = None) -> int:
    p = parser()
    args = p.parse_args(argv)
    if not getattr(args, "command", None):
        p.print_help(sys.stderr)
        return EXIT_USAGE
    ui = UI(color=False if args.no_color else None, plain=args.plain)
    try:
        return args.func(args, ui)
    except WrsError as exc:
        ui.fail(str(exc))
        if exc.hint:
            for line in exc.hint.splitlines():
                ui.hint(line)
        return exc.code
    except KeyboardInterrupt:
        ui.err.write("\x1b[?25h")
        ui.warn("Interrupted")
        return EXIT_INTERRUPT
    except subprocess.TimeoutExpired as exc:
        ui.fail(f"timed out: {' '.join(exc.cmd) if isinstance(exc.cmd, list) else exc.cmd}")
        return EXIT_FAIL


if __name__ == "__main__":
    sys.exit(main())
